# Copy this file to .env and fill in your own values.
# .env is ignored by git - never commit it.

# Your user ID on the host (run: id -u). Usually 1000 on Linux.
AIRFLOW_UID=1000

# Installed into the Airflow containers on every start
_PIP_ADDITIONAL_REQUIREMENTS="dbt-snowflake==1.12.5 click==8.2.1"

# Snowflake credentials used by dbt (see olist_dbt/profiles.yml)
SNOWFLAKE_ACCOUNT=your-account-identifier
SNOWFLAKE_USER=your-username
SNOWFLAKE_PASSWORD=your-password
